<UserControl x:Class="TbotUltra.Desktop.Views.BuildingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:TbotUltra.Desktop.Views"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="760">
    <UserControl.Resources>
        <CollectionViewSource x:Key="BuildingTopSlotsView"
                              Source="{Binding BuildingsVm.BuildingSlots, RelativeSource={RelativeSource AncestorType=Window}}"
                              Filter="BuildingTopSlotsView_Filter" />
        <CollectionViewSource x:Key="BuildingRemainingSlotsView"
                              Source="{Binding BuildingsVm.BuildingSlots, RelativeSource={RelativeSource AncestorType=Window}}"
                              Filter="BuildingRemainingSlotsView_Filter" />

        <DataTemplate x:Key="BuildingSlotButtonTemplate">
            <Button Margin="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Padding="8,7"
                    Width="110"
                    MinHeight="72"
                    Command="{Binding DataContext.SlotSelectedCommand, RelativeSource={RelativeSource AncestorType={x:Type views:BuildingsPanel}}}"
                    CommandParameter="{Binding}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SlotCardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasPendingUpgrade}" Value="True">
                                <Setter TargetName="SlotCardBorder" Property="BorderBrush" Value="{DynamicResource CapitalBrush}" />
                                <Setter TargetName="SlotCardBorder" Property="Background" Value="{DynamicResource SlotSelectedBgBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasPendingConstruct}" Value="True">
                                <Setter TargetName="SlotCardBorder" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                <Setter TargetName="SlotCardBorder" Property="Background" Value="{DynamicResource HeroAdvBgBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SlotCardBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter TargetName="SlotCardBorder" Property="BorderBrush" Value="{DynamicResource TerminalFgBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SlotCardBorder" Property="Background" Value="{DynamicResource InfoBgBrush}" />
                                <Setter TargetName="SlotCardBorder" Property="BorderBrush" Value="{DynamicResource SlotSelectedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="{Binding SlotLabel}"
                               FontSize="11"
                               Foreground="{DynamicResource BorderMutedBrush}"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding NameLabel}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="32"
                               Margin="0,3,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOccupied}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding LevelStatusLabel}"
                               FontSize="11"
                               Margin="0,3,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMaxLevel}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource CapitalBrush}" />
                                    </DataTrigger>
                                    <!-- A completed demolition may still have a queued cleanup marker.
                                         Only an occupied building is an active demolition; an empty
                                         slot must retain the normal neutral empty-slot color. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsDemolishing}" Value="True" />
                                            <Condition Binding="{Binding IsOccupied}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="{DynamicResource UnreadBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding WatchtowerStatusLabel}"
                               FontSize="10"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource CapitalBrush}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="Buildings" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Manage your village buildings. Click a slot to view and manage building details."
                           Foreground="{DynamicResource TextSubtleBrush}" Margin="0,2,0,8" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Load buildings"
                        Width="118"
                        Height="28"
                        Background="{DynamicResource SuccessBgBrush}"
                        Foreground="{DynamicResource SuccessTextBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                        Command="{Binding LoadCommand}"
                        ToolTip="Read the current buildings from the village and refresh the buildings list with their slots and levels." />
                <Button Content="Upgrade all to max"
                        Width="136"
                        Height="28"
                        Margin="6,0,0,0"
                        Background="{DynamicResource WarningBgBrush}"
                        Foreground="{DynamicResource WarningTextBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        ToolTip="Queues upgrades for all buildings until each one reaches its maximum level."
                        Command="{Binding UpgradeAllToMaxCommand}" />
                <Button Height="28"
                        Margin="8,0,0,0"
                        Padding="9,0"
                        Background="{DynamicResource SurfaceAltBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Command="{Binding OpenQueueCommand}"
                        ToolTip="Open the selected village's queue. The time in parentheses includes the 25% construct-faster bonus.">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Queue: "
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding QueueTimeText}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text=" ("
                                   Foreground="{DynamicResource ConstructFasterTextBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ConstructFasterQueueTimeText}"
                                   Foreground="{DynamicResource ConstructFasterTextBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text=")"
                                   Foreground="{DynamicResource ConstructFasterTextBrush}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Source={StaticResource BuildingTopSlotsView}}"
                                  ItemTemplate="{StaticResource BuildingSlotButtonTemplate}"
                                  Width="448"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Height="10" Background="Transparent" />

                    <ItemsControl ItemsSource="{Binding Source={StaticResource BuildingRemainingSlotsView}}"
                                  ItemTemplate="{StaticResource BuildingSlotButtonTemplate}"
                                  Width="448"
                                  HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Right column: construction settings, split into two cards (placements + timing). -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14,12">
                <StackPanel>
                    <TextBlock Text="Construction settings"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Recommended placements for these buildings (optional):"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,4,0,8" />
                    <ItemsControl>
                        <ItemsControl.Items>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Slot 22" Width="52" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Barracks" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Slot 29" Width="52" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Stable" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Slot 31" Width="52" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Marketplace" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Slot 21" Width="52" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Workshop" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Slot 11" Width="52" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="Hospital" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}" />
                            </StackPanel>
                        </ItemsControl.Items>
                    </ItemsControl>
                    <Button Content="Building templates"
                            Height="30"
                            Margin="0,8,0,0"
                            Background="{DynamicResource SuccessBgBrush}"
                            Foreground="{DynamicResource SuccessTextBrush}"
                            BorderBrush="{DynamicResource SuccessBorderBrush}"
                            FontWeight="SemiBold"
                            ToolTip="Create, save, and queue reusable building templates for the selected village."
                            Command="{Binding TemplatesCommand}" />
                    <Button Content="Show building slots"
                            Height="30"
                            Margin="0,6,0,0"
                            ToolTip="Open a reference image showing which building slot number sits where in a village."
                            Command="{Binding ShowSlotsCommand}" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14,12"
                    Margin="0,10,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Demolish building" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ContentControl Style="{DynamicResource InfoTooltipIconStyle}"
                                        Margin="7,1,0,0"
                                        ToolTip="Queue demolitions from a building slot. The bot starts one level at a time, stores the server timer plus the configured random delay, and continues without waiting in the browser." />
                    </StackPanel>
                    <Border Margin="0,6,0,10"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BuildingsVm.DemolishStatusHasTimer, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Padding" Value="8,4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding BuildingsVm.DemolishStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BuildingsVm.DemolishStatusHasTimer, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Button Content="Demolish overview" Height="30" Margin="0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DemolishOverviewCommand}" />
                    <Button Content="Stop demolition" Height="30" Margin="0,6,0,0"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource DangerBgBrush}"
                            Foreground="{DynamicResource DangerTextBrush}"
                            BorderBrush="{DynamicResource DangerBorderBrush}"
                            Command="{Binding StopDemolitionCommand}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
