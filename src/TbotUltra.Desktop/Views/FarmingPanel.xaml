<UserControl x:Class="TbotUltra.Desktop.Views.FarmingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TbotUltra.Desktop.Views">
    <TabControl x:Name="FarmingTabControl"
                Background="{DynamicResource AppBackgroundBrush}">
        <TabItem x:Name="FarmListsTabItem" Header="Farming">
                     <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Farming" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <Grid Grid.Row="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Farm lists"
                                                               FontSize="22"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="Choose which lists run and set their sending cadence."
                                                               Foreground="{DynamicResource TextSubtleBrush}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button x:Name="FarmListSendAllNowButton"
                                                        Grid.Column="1"
                                                        Content="Send now"
                                                        MinWidth="105"
                                                        Height="32"
                                                        VerticalAlignment="Center"
                                                        IsEnabled="False"
                                                        Command="{Binding SendAllNowCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                            <TextBlock x:Name="FarmingStatusTextBlock"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="Collapsed" />
                                        </StackPanel>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="FarmListsItemsControl"
                                                              ItemsSource="{Binding FarmLists}">
                                                    <ItemsControl.GroupStyle>
                                                        <GroupStyle>
                                                            <GroupStyle.HeaderTemplate>
                                                                <DataTemplate>
                                                                    <!-- Grouped by village ordinal; the heading text (name + coordinates)
                                                                         is taken from the group's first row. Empty for the placeholder
                                                                         group, whose header is then hidden. -->
                                                                    <Border Margin="0,6,0,6" Padding="10,0,10,4">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
                                                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Items[0].VillageHeaderText}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Items[0].VillageHeaderText}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="80" />
                                                                                <ColumnDefinition Width="90" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Items[0].VillageHeaderText}"
                                                                                       FontWeight="SemiBold"
                                                                                       FontSize="13"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                            <Border Grid.Column="1"
                                                                                    Tag="FarmListNextSendBadge"
                                                                                    Margin="0,0,8,0"
                                                                                    Padding="8,3"
                                                                                    CornerRadius="8"
                                                                                    VerticalAlignment="Center"
                                                                                    Background="{DynamicResource WarningBgBrush}"
                                                                                    BorderBrush="{DynamicResource WarningBorderBrush}"
                                                                                    BorderThickness="1">
                                                                                <TextBlock Tag="FarmListNextSendText"
                                                                                           Text="{Binding NextSendDisplay, RelativeSource={RelativeSource AncestorType={x:Type views:FarmingPanel}}}"
                                                                                           FontSize="12"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource WarningTextBrush}" />
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </GroupStyle.HeaderTemplate>
                                                        </GroupStyle>
                                                    </ItemsControl.GroupStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="9" Padding="10" Margin="0,0,0,10">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource InfoBgBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                                                                                <Setter Property="BorderThickness" Value="2" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <ToggleButton Grid.Column="0"
                                                                                  Grid.RowSpan="2"
                                                                                  Style="{StaticResource AutomationToggleStyle}"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="0,0,10,0"
                                                                                  IsEnabled="{Binding HasFarmList}"
                                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" />

                                                                    <Border Grid.Column="1" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="3,0,0,0" Padding="10,0,0,0">
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                                <TextBlock Text="{Binding FarmCountText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,8,0" />
                                                                                <ProgressBar Width="120"
                                                                                             Height="8"
                                                                                             VerticalAlignment="Center"
                                                                                             Minimum="0"
                                                                                             Maximum="100"
                                                                                             Value="{Binding FillPercent, Mode=OneWay}" />
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <Border Grid.Row="1"
                                                                            Grid.Column="1"
                                                                            Grid.ColumnSpan="3"
                                                                            Margin="10,8,0,0"
                                                                            Padding="8,5"
                                                                            VerticalAlignment="Center"
                                                                            Background="{DynamicResource ControlBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource BorderMutedBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            IsEnabled="{Binding DataContext.SendToggledLists, RelativeSource={RelativeSource AncestorType={x:Type views:FarmingPanel}}}"
                                                                            ToolTip="{Binding IntervalErrorText}">
                                                                        <StackPanel>
                                                                        <TextBlock Text="SEND EVERY (MIN)"
                                                                                   FontSize="9"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                                                   Margin="0,0,0,3" />
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBox Width="42"
                                                                                     Height="25"
                                                                                     VerticalContentAlignment="Center"
                                                                                     Text="{Binding IntervalMinMinutesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                                     ToolTip="Optional minimum. Leave both fields empty to use the global delay." />
                                                                            <TextBlock Text="to" Margin="4,0" VerticalAlignment="Center"
                                                                                       Foreground="{DynamicResource TextSubtleBrush}" />
                                                                            <TextBox Width="42"
                                                                                     Height="25"
                                                                                     VerticalContentAlignment="Center"
                                                                                     Text="{Binding IntervalMaxMinutesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                                     ToolTip="Optional maximum. Leave both fields empty to use the global delay." />
                                                                        </StackPanel>
                                                                        <Grid Margin="0,3,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock FontSize="10"
                                                                                       Foreground="{DynamicResource TextSubtleBrush}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="Uses fallback interval" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding HasIntervalOverride}" Value="True">
                                                                                                <Setter Property="Text" Value="Individual interval" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding NextSendText}"
                                                                                       FontSize="10"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding IntervalErrorText}"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource DangerTextBrush}"
                                                                                   TextWrapping="Wrap"
                                                                                   MaxWidth="110">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasIntervalError}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        </StackPanel>
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Opacity" Value="1" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasFarmList}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                                        <Setter Property="Opacity" Value="0.45" />
                                                                                        <Setter Property="ToolTip" Value="Switch to Individual schedules to set a separate interval for this list." />
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>

                                                                    <Border Grid.Column="2"
                                                                            Margin="8,0,8,0"
                                                                            Padding="10,4"
                                                                            CornerRadius="8"
                                                                            VerticalAlignment="Center"
                                                                            BorderThickness="1">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ShowLastSentTimer}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding HasLastSent}" Value="False">
                                                                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding LastSendFailed}" Value="True">
                                                                                        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="{Binding LastSentText}" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasLastSent}" Value="False">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding LastSendFailed}" Value="True">
                                                                                            <Setter Property="Text" Value="Failed" />
                                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                                            <Setter Property="Text" Value="{Binding LastSentText}" />
                                                                                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>

                                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                                        <Button Content="{Binding ActionText}"
                                                                                MinWidth="90"
                                                                                Height="32"
                                                                                Command="{Binding DataContext.SendNowCommand, RelativeSource={RelativeSource AncestorType={x:Type views:FarmingPanel}}}"
                                                                                CommandParameter="{Binding}"
                                                                                IsEnabled="{Binding CanSendNow}"
                                                                                >
                                                                            <Button.Style>
                                                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                                    <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                                            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                                                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                        </ScrollViewer>

                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Farm list tools"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="Refresh the overview or change list contents."
                                                           Foreground="{DynamicResource TextSubtleBrush}"
                                                           Margin="0,3,0,10" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="AnalyzeFarmListsButton"
                                                            Grid.Column="0"
                                                            Content="Analyze lists"
                                                            Background="{DynamicResource SuccessBgBrush}"
                                                            Foreground="{DynamicResource SuccessTextBrush}"
                                                            BorderBrush="{DynamicResource SuccessBorderBrush}"
                                                            Margin="0,0,4,0"
                                                            Command="{Binding AnalyzeCommand}" />
                                                    <Button x:Name="CreateFarmListButton"
                                                            Grid.Column="1"
                                                            Content="Create list"
                                                            Margin="4,0"
                                                            Command="{Binding CreateFarmListCommand}" />
                                                    <Button x:Name="AddFarmsToListButton"
                                                            Grid.Column="2"
                                                            Content="Add farms"
                                                            Margin="4,0,0,0"
                                                            Command="{Binding AddFarmsCommand}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Farm settings"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Control how lists are sent and how failed targets are handled."
                                                       Foreground="{DynamicResource TextSubtleBrush}"
                                                       Margin="0,3,0,14" />

                                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="SENDING SCHEDULE"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSubtleBrush}"
                                                               Margin="0,0,0,9" />
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" CornerRadius="6" Padding="10" Margin="0,0,5,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SendToggledLists}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <RadioButton x:Name="FarmSendListPerListRadioButton"
                                                                         GroupName="FarmSendMode"
                                                                         HorizontalContentAlignment="Stretch"
                                                                         IsChecked="{Binding SendToggledLists, Mode=TwoWay}">
                                                                <StackPanel Margin="4,0,0,0">
                                                                    <TextBlock Text="Individual schedules" FontWeight="SemiBold" />
                                                                    <TextBlock Text="Each enabled list uses its own timing."
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextSubtleBrush}"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </RadioButton>
                                                        </Border>
                                                        <Border Grid.Column="1" CornerRadius="6" Padding="10" Margin="5,0,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderMutedBrush}" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SendAllLists}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <RadioButton x:Name="FarmSendAllAtOnceRadioButton"
                                                                         GroupName="FarmSendMode"
                                                                         HorizontalContentAlignment="Stretch"
                                                                         IsChecked="{Binding SendAllLists, Mode=TwoWay}">
                                                                <StackPanel Margin="4,0,0,0">
                                                                    <TextBlock Text="Send all together" FontWeight="SemiBold" />
                                                                    <TextBlock Text="All lists use the same timing."
                                                                               FontSize="10"
                                                                               Foreground="{DynamicResource TextSubtleBrush}"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </RadioButton>
                                                        </Border>
                                                    </Grid>
                                                    <Border BorderBrush="{DynamicResource BorderMutedBrush}"
                                                            BorderThickness="0,1,0,0"
                                                            Padding="0,11,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DispatchIntervalTitle}"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding DispatchIntervalDescription}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextSubtleBrush}"
                                                                           TextWrapping="Wrap"
                                                                           MaxWidth="210" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Min" VerticalAlignment="Center" Margin="0,0,5,0"
                                                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                                                <TextBox x:Name="FarmDispatchDelayMinTextBox"
                                                                         Width="52"
                                                                         Height="28"
                                                                         VerticalContentAlignment="Center"
                                                                         Text="{Binding DispatchDelayMinMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                                <TextBlock Text="Max" VerticalAlignment="Center" Margin="12,0,5,0"
                                                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                                                <TextBox x:Name="FarmDispatchDelayMaxTextBox"
                                                                         Width="52"
                                                                         Height="28"
                                                                         VerticalContentAlignment="Center"
                                                                         Text="{Binding DispatchDelayMaxMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                                <TextBlock Text="min" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,0,10">
                                                <StackPanel>
                                                    <StackPanel Margin="0,0,0,9">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="FAILED ATTACKS"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSubtleBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                                            Margin="7,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            ToolTip="Deactivate targets whose latest result matches the selected color. Moving uses the same Edit action and requires deactivation for that color." />
                                                        </StackPanel>
                                                        <TextBlock Text="Handle red and yellow results independently."
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <Border Background="{DynamicResource ControlBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderMutedBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="106" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{DynamicResource DangerBrush}" CornerRadius="5,0,0,5" />
                                                            <CheckBox x:Name="DeactivateRedFarmLossesCheckBox"
                                                                      Grid.Column="1"
                                                                      Content="Red attacks"
                                                                      Margin="12,11,8,11"
                                                                      Foreground="{DynamicResource DangerTextBrush}"
                                                                      FontWeight="SemiBold"
                                                                      IsChecked="{Binding DeactivateRedLosses, Mode=TwoWay}" />
                                                            <CheckBox x:Name="MoveRedFarmLossesCheckBox"
                                                                      Grid.Column="2"
                                                                      Content="Move to list"
                                                                      Margin="0,11,12,11"
                                                                      IsEnabled="{Binding CanMoveRedLosses}"
                                                                      IsChecked="{Binding MoveRedLosses, Mode=TwoWay}" />
                                                            <ComboBox x:Name="RedFarmLossDestinationComboBox"
                                                                      Grid.Column="3"
                                                                      Width="145"
                                                                      Height="28"
                                                                      Margin="0,6,8,6"
                                                                      HorizontalAlignment="Right"
                                                                      DisplayMemberPath="DisplayText"
                                                                      IsEnabled="{Binding MoveRedLosses}"
                                                                      ItemsSource="{Binding LossDestinations}"
                                                                      SelectedItem="{Binding SelectedRedLossDestination, Mode=TwoWay}" />
                                                        </Grid>
                                                    </Border>

                                                    <Border Background="{DynamicResource ControlBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderMutedBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4" />
                                                                <ColumnDefinition Width="106" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{DynamicResource WarningBrush}" CornerRadius="5,0,0,5" />
                                                            <CheckBox x:Name="DeactivateYellowFarmLossesCheckBox"
                                                                      Grid.Column="1"
                                                                      Content="Yellow attacks"
                                                                      Margin="12,11,8,11"
                                                                      Foreground="{DynamicResource WarningTextBrush}"
                                                                      FontWeight="SemiBold"
                                                                      IsChecked="{Binding DeactivateYellowLosses, Mode=TwoWay}" />
                                                            <CheckBox x:Name="MoveYellowFarmLossesCheckBox"
                                                                      Grid.Column="2"
                                                                      Content="Move to list"
                                                                      Margin="0,11,12,11"
                                                                      IsEnabled="{Binding CanMoveYellowLosses}"
                                                                      IsChecked="{Binding MoveYellowLosses, Mode=TwoWay}" />
                                                            <ComboBox x:Name="YellowFarmLossDestinationComboBox"
                                                                      Grid.Column="3"
                                                                      Width="145"
                                                                      Height="28"
                                                                      Margin="0,6,8,6"
                                                                      HorizontalAlignment="Right"
                                                                      DisplayMemberPath="DisplayText"
                                                                      IsEnabled="{Binding MoveYellowLosses}"
                                                                      ItemsSource="{Binding LossDestinations}"
                                                                      SelectedItem="{Binding SelectedYellowLossDestination, Mode=TwoWay}" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="OASIS LOSSES"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSubtleBrush}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                            <CheckBox x:Name="DeactivateFarmOasisLossesCheckBox"
                                                                      Content="Deactivate oasis targets"
                                                                      IsChecked="{Binding DeactivateOasisLosses, Mode=TwoWay}" />
                                                            <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                                            Margin="7,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            ToolTip="Disable oasis targets whose latest result matches the selected color. Oasis targets are never moved." />
                                                        </StackPanel>
                                                        <TextBlock Text="Oases are deactivated only — never moved."
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <CheckBox x:Name="DeactivateRedFarmOasisLossesCheckBox"
                                                                  Content="Red"
                                                                  Foreground="{DynamicResource DangerTextBrush}"
                                                                  Margin="0,0,12,0"
                                                                  IsChecked="{Binding DeactivateRedOasisLosses, Mode=TwoWay}" />
                                                        <CheckBox x:Name="DeactivateYellowFarmOasisLossesCheckBox"
                                                                  Content="Yellow"
                                                                  Foreground="{DynamicResource WarningTextBrush}"
                                                                  Margin="0"
                                                                  IsChecked="{Binding DeactivateYellowOasisLosses, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                          </StackPanel>
                                      </Border>
                                    </StackPanel>
                                  </ScrollViewer>
                             </Grid>
                         </Grid>
                     </Grid>
        </TabItem>
        <TabItem x:Name="InactiveOasisScanTabItem" Header="Inactive / oasis scan">
            <ContentControl x:Name="TravcoToolsHost"
                            Background="{DynamicResource AppBackgroundBrush}" />
        </TabItem>
    </TabControl>
</UserControl>
