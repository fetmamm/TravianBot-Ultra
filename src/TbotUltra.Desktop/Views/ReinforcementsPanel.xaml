<UserControl x:Class="TbotUltra.Desktop.Views.ReinforcementsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<UserControl.Resources>
  <ControlTemplate x:Key="ContentOnlyTabControlTemplate" TargetType="TabControl">
    <ContentPresenter ContentSource="SelectedContent" />
  </ControlTemplate>
</UserControl.Resources>
<TabControl x:Name="SendTroopsTabControl" Background="{DynamicResource AppBackgroundBrush}">
  <TabItem x:Name="ReinforcementsTabItem" Header="Reinforcements">
<Grid Background="{DynamicResource AppBackgroundBrush}">
    <Border VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Reinforcements"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Width="14"
                            Height="14"
                            Margin="8,3,0,0"
                            CornerRadius="7"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Top"
                            ToolTipService.InitialShowDelay="0">
                        <Border.ToolTip>
                            <ToolTip MaxWidth="360">
                                <StackPanel Width="320">
                                    <TextBlock Text="Reinforcements"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TooltipForegroundBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBlock TextWrapping="Wrap"
                                               Text="Sends selected troops from chosen source villages to the selected target village as reinforcements." />
                                    <TextBlock Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Text="Use the Troops button on each source village when different villages should send different troop types or amounts." />
                                </StackPanel>
                            </ToolTip>
                        </Border.ToolTip>
                        <TextBlock Text="i"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Text="Target village"
                           Foreground="{DynamicResource TextSubtleBrush}"
                           FontSize="12"
                           Margin="0,0,0,4" />
                <ComboBox Grid.Row="2"
                          x:Name="ReinforcementTargetVillageComboBox"
                          Height="30"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="ReinforcementSetting_SelectionChanged" />

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Source villages"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <Button x:Name="ReinforcementMarkAllTroopsButton"
                            Grid.Column="1"
                            Content="Mark all"
                            Padding="8,2"
                            Click="MarkAllReinforcementTroopsButton_Click" />
                    </Grid>
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8"
                        MinHeight="160">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ReinforcementSourceVillagesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelectAsSource}"
                                                  VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1"
                                                    Margin="8,0,8,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding TroopSummaryText}"
                                                       Foreground="{DynamicResource TextSubtleBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="Troops"
                                                Padding="8,2"
                                                Tag="{Binding}"
                                                Click="ChooseReinforcementVillageTroopsButton_Click" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding SourceStatusText}"
                                                   Foreground="{DynamicResource BorderMutedBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                </Grid>
                <TextBlock Grid.Row="4"
                           x:Name="ReinforcementTroopsSummaryTextBlock"
                           Text="No troops selected."
                           Foreground="{DynamicResource TextSubtleBrush}"
                           FontSize="12"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap" />
            </Grid>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Send troop settings"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="128" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Min (min)"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               FontSize="12"
                               Margin="0,0,0,4" />
                    <TextBox Grid.Row="1"
                             Grid.Column="0"
                             x:Name="ReinforcementSendMinMinutesTextBox"
                             Height="28"
                             VerticalContentAlignment="Center"
                             LostFocus="ReinforcementSetting_TextChanged" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="Max (min)"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               FontSize="12"
                               Margin="0,0,0,4" />
                    <TextBox Grid.Row="1"
                             Grid.Column="2"
                             x:Name="ReinforcementSendMaxMinutesTextBox"
                             Height="28"
                             VerticalContentAlignment="Center"
                             LostFocus="ReinforcementSetting_TextChanged" />
                </Grid>
                <TextBlock x:Name="ReinforcementTroopsDetailTextBlock"
                           Text=""
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <TextBlock x:Name="ReinforcementStatusTextBlock"
                           Text=""
                           Foreground="{DynamicResource WarningTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <Button x:Name="ReinforcementQueueNowButton"
                        Content="Queue now"
                        Padding="10,4"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0"
                        Click="QueueReinforcementsNowButton_Click" />

            </StackPanel>
        </Grid>
    </Border>
</Grid>
  </TabItem>
  <TabItem x:Name="IncomingAttacksTabItem" Header="Incoming attacks">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Incoming attacks" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <ContentControl x:Name="IncomingAttacksInfoIcon"
                            Style="{DynamicResource InfoTooltipIconStyle}"
                            Margin="8,0,0,0"
                            ToolTip="Incoming attacks and raids detected on Dorf1 and verified in Rally Point. Times use the Travian server clock." />
          </StackPanel>
          <Button x:Name="ClearIncomingAttackListButton"
                  Grid.Column="1"
                  Content="Clear list"
                  Padding="12,5"
                  Background="{DynamicResource DangerBgBrush}"
                  BorderBrush="{DynamicResource DangerBorderBrush}"
                  Foreground="{DynamicResource DangerTextBrush}"
                  Click="ClearIncomingAttackListButton_Click" />
        </Grid>
        <Border x:Name="IncomingAttackMonitoringPanel"
                Grid.Row="1" Margin="0,0,0,12" Padding="10,9" MinHeight="66" CornerRadius="6"
                Background="{DynamicResource ControlBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
              <TextBlock Text="Villages monitored" FontWeight="SemiBold" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <Button x:Name="ToggleAllIncomingAttackMonitoringButton"
                      Content="Toggle all" Margin="10,0,0,0" Padding="8,2" MinHeight="0"
                      FontSize="10" Click="ToggleAllIncomingAttackMonitoringButton_Click"
                       ToolTip="Enable all villages if any are off; otherwise disable all villages" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
              <CheckBox x:Name="IncomingAttackSoundAlertCheckBox"
                        Content="Play sound for new attacks"
                        VerticalAlignment="Center"
                        Checked="IncomingAttackSoundSetting_Changed"
                        Unchecked="IncomingAttackSoundSetting_Changed"
                        ToolTip="Play one sound when one or more new incoming attacks are confirmed" />
              <ContentControl x:Name="IncomingAttackSoundInfoIcon"
                              Style="{StaticResource SettingInfoIconStyle}"
                              ToolTip="Plays one alert sound when one or more new incoming attacks are confirmed. Turning this off does not disable attack monitoring." />
              <TextBlock Text="Cooldown" Margin="18,0,0,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource SlateTextBrush}" />
              <ContentControl x:Name="IncomingAttackSoundCooldownInfoIcon"
                              Style="{StaticResource SettingInfoIconStyle}"
                              ToolTip="Sets the minimum time between alert sounds. New attacks are still recorded during the cooldown, but no additional sound plays until it expires." />
              <ComboBox x:Name="IncomingAttackSoundCooldownComboBox"
                        Width="82" Margin="7,0,0,0" SelectedIndex="0"
                        SelectionChanged="IncomingAttackSoundSetting_Changed"
                        ToolTip="Minimum time between incoming attack sounds">
                <ComboBoxItem Content="1 min" Tag="1" />
                <ComboBoxItem Content="2 min" Tag="2" />
                <ComboBoxItem Content="5 min" Tag="5" />
                <ComboBoxItem Content="10 min" Tag="10" />
              </ComboBox>
            </StackPanel>
            <ItemsControl x:Name="IncomingAttackMonitoringVillageItemsControl">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,16,4">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton Width="38" Height="22" Style="{StaticResource AutomationToggleStyle}"
                                    IsChecked="{Binding Enabled}" Tag="{Binding}"
                                    Click="IncomingAttackMonitoring_Changed"
                                    ToolTip="Enable incoming attack monitoring and evasion for this village" />
                      <TextBlock Text="{Binding VillageName}" Margin="7,0,0,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <DataGrid x:Name="IncomingAttackDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserResizeColumns="False"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
          <DataGrid.GroupStyle>
            <GroupStyle>
              <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                          <Border Margin="0,8,0,2"
                                  Padding="10,7"
                                  Background="{DynamicResource ControlBackgroundBrush}"
                                  BorderBrush="{DynamicResource DangerBorderBrush}"
                                  BorderThickness="3,0,0,0"
                                  CornerRadius="3">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Name}"
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextPrimaryBrush}" />
                              <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding ItemCount}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerTextBrush}" />
                                <TextBlock Text=" incoming"
                                           Foreground="{DynamicResource SlateTextBrush}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                          <ItemsPresenter />
                        </StackPanel>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </GroupStyle.ContainerStyle>
            </GroupStyle>
          </DataGrid.GroupStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Type" Width="90" MinWidth="90">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding TypeText}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding TypeText}" Value="Raid">
                            <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding TypeText}" Value="Attack">
                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Player" Binding="{Binding SourcePlayerName}" Width="*" MinWidth="160" />
            <DataGridTextColumn Header="Village" Binding="{Binding SourceVillageName}" Width="*" MinWidth="160" />
            <DataGridTextColumn Header="Coords" Binding="{Binding SourceCoordinatesText}" Width="90" MinWidth="90" />
            <DataGridTextColumn Header="Arrival (server)" Binding="{Binding ArrivalText}" Width="155" MinWidth="155" />
            <DataGridTextColumn Header="Countdown" Binding="{Binding CountdownText}" Width="110" MinWidth="110" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </TabItem>
  <TabItem x:Name="CatapultWavesTabItem" Header="Catapult waves">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
      <Border Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16"
              VerticalAlignment="Top">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Catapult waves"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <ContentControl x:Name="CatapultWavesInfoIcon"
                            Style="{DynamicResource InfoTooltipIconStyle}"
                            Margin="8,0,0,0"
                            ToolTip="Reads available troops from Rally Point, prepares one first attack and multiple attack waves. Catapult targets use Random automatically when catapults are included." />
          </StackPanel>
          <TextBlock Text="Prepare one first attack followed by multiple precisely timed attack waves."
                     Foreground="{DynamicResource TextSubtleBrush}"
                     FontSize="12"
                     Margin="0,0,0,14" />
          <Button x:Name="StartCatapultWavesButton"
                  Content="Start catapult waves"
                  Width="180"
                  HorizontalAlignment="Left"
                  ToolTip="Opens Catapult Waves for the active village."
                  Background="{DynamicResource SuccessBgBrush}"
                  Foreground="{DynamicResource SuccessTextBrush}"
                  BorderBrush="{DynamicResource SuccessBorderBrush}"
                  Click="StartCatapultWavesButton_Click" />
          <TextBlock x:Name="CatapultWavesStatusTextBlock"
                     Text="No catapult waves running."
                     Foreground="{DynamicResource TextMutedBrush}"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </TabItem>
</TabControl>
</UserControl>

