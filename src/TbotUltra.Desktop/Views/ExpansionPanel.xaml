<UserControl x:Class="TbotUltra.Desktop.Views.ExpansionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Background="{DynamicResource AppBackgroundBrush}" Margin="4">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Expansion" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
      <ContentControl Style="{DynamicResource InfoTooltipIconStyle}" Margin="8,0,0,0"
                      ToolTip="Trains settlers in the Residence/Palace and founds a new village with them. Both run as queue items for the selected village." />
    </StackPanel>

    <Border Margin="0,12,0,10" Padding="12" CornerRadius="7"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="Train settlers" FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                   Text="Trains 3 settlers per free expansion slot (Residence level 10/20, Palace 10/15/20). Settlers at home or in training are counted." />
        <Button x:Name="TrainSettlersButton" Content="Queue settler training" HorizontalAlignment="Left" Click="TrainSettlers_Click" />
      </StackPanel>
    </Border>

    <Border Padding="12" CornerRadius="7"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <StackPanel>
        <TextBlock Text="Found new village" FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"
                   Text="Sends 3 settlers from the selected village to a free field. Needs enough culture points and 750 of each resource." />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="X" VerticalAlignment="Center" />
          <TextBox x:Name="FoundXTextBox" Width="70" Margin="6,0,12,0" />
          <TextBlock Text="Y" VerticalAlignment="Center" />
          <TextBox x:Name="FoundYTextBox" Width="70" Margin="6,0,12,0" />
          <TextBlock Text="Tribe" VerticalAlignment="Center" />
          <ComboBox x:Name="FoundTribeComboBox" Width="130" Margin="6,0,20,0" SelectedIndex="0"
                    ToolTip="Asked by the game only for the account's first three foundings.">
            <ComboBoxItem Content="Own tribe" Tag="" />
            <ComboBoxItem Content="Romans" Tag="1" />
            <ComboBoxItem Content="Teutons" Tag="2" />
            <ComboBoxItem Content="Gauls" Tag="3" />
            <ComboBoxItem Content="Egyptians" Tag="6" />
            <ComboBoxItem Content="Huns" Tag="7" />
            <ComboBoxItem Content="Spartans" Tag="8" />
          </ComboBox>
          <Button x:Name="FoundVillageButton" Content="Queue founding" Click="FoundVillage_Click" />
        </StackPanel>
        <TextBlock x:Name="ExpansionStatusText" Margin="0,8,0,0" Foreground="{DynamicResource TextMutedBrush}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
