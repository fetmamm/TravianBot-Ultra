<UserControl x:Class="TbotUltra.Desktop.Views.TroopsHubPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TbotUltra.Desktop.Views">
  <TabControl x:Name="TroopsTabControl" Background="{DynamicResource AppBackgroundBrush}"
              SelectionChanged="TroopsTabControl_SelectionChanged">
    <TabItem x:Name="BuildTroopsTabItem" Header="Build Troops">
      <views:TroopsPanel Section="Build" />
    </TabItem>
    <TabItem x:Name="UpgradeTroopsTabItem" Header="Upgrade troops">
      <views:TroopsPanel x:Name="UpgradeTroopsContent" Section="Upgrade" />
    </TabItem>
    <TabItem x:Name="ReinforcementsTabItem" Header="Reinforcements">
      <views:ReinforcementsPanel x:Name="ReinforcementsContent" Section="Reinforcements" />
    </TabItem>
    <TabItem x:Name="IncomingAttacksTabItem" Header="Incoming attacks">
      <views:ReinforcementsPanel x:Name="IncomingAttacksContent" Section="Incoming" />
    </TabItem>
    <TabItem x:Name="EvasionTabItem" Header="Evasion">
      <views:TroopEvasionPanel x:Name="EvasionContent" />
    </TabItem>
    <TabItem x:Name="ExpansionTabItem" Header="Expansion">
      <views:ExpansionPanel x:Name="ExpansionContent" />
    </TabItem>
    <TabItem x:Name="CatapultWavesTabItem" Header="Catapult waves">
      <views:ReinforcementsPanel x:Name="CatapultWavesContent" Section="Catapult" />
    </TabItem>
    <TabItem x:Name="BreweryCelebrationTabItem" Header="Brewery celebration">
      <views:TroopsPanel Section="Brewery" />
    </TabItem>
  </TabControl>
</UserControl>
