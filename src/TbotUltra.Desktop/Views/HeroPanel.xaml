<UserControl x:Class="TbotUltra.Desktop.Views.HeroPanel"
             x:Name="HeroPanelRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TbotUltra.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HeroViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="HeroResourceHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style x:Key="HeroResourceColumnToggleStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="2,2,2,12">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="SectionTitle" Text="Hero / Adventures"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="SectionDescription" Text="Configure hero behaviour and queue adventures."
                               Foreground="{DynamicResource TextSubtleBrush}"
                               FontSize="12"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Adventure controls: live state first, then grouped decisions. -->
            <Border x:Name="SettingsCard"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="2,0,2,12">
                <StackPanel>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Adventure control"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Check readiness, choose when to leave, and configure optional automation."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <DockPanel>
                                <Button x:Name="RefreshAdventuresButton"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource RefreshIconButtonStyle}"
                                        ToolTip="Refresh adventure count"
                                        Command="{Binding RefreshAdventuresCommand}" />
                                <StackPanel>
                                    <TextBlock Text="AVAILABLE ADVENTURES"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSubtleBrush}" />
                                    <TextBlock Text="{Binding AdventureCountText}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextStrongBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AdventureCountText}" Value="0">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <DockPanel>
                                <Button x:Name="RefreshHeroHpButton"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource RefreshIconButtonStyle}"
                                        ToolTip="Refresh hero HP"
                                        Command="{Binding RefreshHpCommand}" />
                                <StackPanel>
                                    <TextBlock Text="HERO HEALTH"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSubtleBrush}" />
                                    <TextBlock Text="{Binding HeroHpText}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessTextStrongBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="4"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HeroStatusText}" Value="Ready">
                                            <Setter Property="Background" Value="{DynamicResource HeroAdvBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource HeroAdvBorderBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HeroLoopTask.HasCountdown}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WarningBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="HERO STATUS"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                <TextBlock FontSize="22"
                                           FontWeight="SemiBold"
                                           Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="--" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HeroStatusText}" Value="Ready">
                                                    <Setter Property="Text" Value="{Binding HeroReadyText}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextStrongBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HeroLoopTask.HasCountdown}" Value="True">
                                                    <Setter Property="Text" Value="{Binding HeroLoopTask.TimerText}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Run conditions"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Limits used before an adventure is queued."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSubtleBrush}"
                                           Margin="0,3,0,12" />
                                <TextBlock Text="Minimum hero HP"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Width="110"
                                         HorizontalAlignment="Left"
                                         Text="{Binding MinHpForAdventure, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,12"
                                         Padding="6,4"
                                         BorderBrush="{DynamicResource BorderSubtleBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <TextBlock Text="Pick order"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                    ToolTip="Shortest adventure first queues the nearest adventure. Top adventure first queues the first adventure shown in the Travian list." />
                                </StackPanel>
                                <RadioButton Content="Shortest adventure first"
                                             IsChecked="{Binding IsAdventurePickShortest}"
                                             Margin="0,0,0,6" />
                                <RadioButton Content="Top adventure first"
                                             IsChecked="{Binding IsAdventurePickTop}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Hero automation"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Keep the hero prepared between adventures."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSubtleBrush}"
                                           Margin="0,3,0,12" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Content="Auto revive"
                                              IsChecked="{Binding AutoRevive}" />
                                    <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                    ToolTip="Automatically starts Hero revival when the Hero is dead and revival is available." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="Auto use ointments"
                                              IsChecked="{Binding AutoUseOintments}" />
                                    <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                    ToolTip="When an adventure is available and Hero HP reaches or falls below Minimum hero HP, use available ointments up to the selected target." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,8,0,0">
                                    <TextBlock Text="Heal to"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,8,0" />
                                    <ComboBox Width="82"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding OintmentTargetHpPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding AutoUseOintments}">
                                        <ComboBoxItem Content="50%" Tag="50" />
                                        <ComboBoxItem Content="60%" Tag="60" />
                                        <ComboBoxItem Content="70%" Tag="70" />
                                        <ComboBoxItem Content="80%" Tag="80" />
                                        <ComboBoxItem Content="90%" Tag="90" />
                                        <ComboBoxItem Content="Max" Tag="100" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Bonus videos"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Optional boosts applied before departure."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSubtleBrush}"
                                           Margin="0,3,0,12" />
                                <CheckBox Content="Increase adventures to hard"
                                          IsChecked="{Binding IncreaseAdventuresToHard}"
                                          Margin="0,0,0,8"
                                          ToolTip="When on, the adventure function may watch the bonus video to raise the next adventure's danger to hard. The percentage is rolled independently for every Hard and -25% video invocation." />
                                <CheckBox Content="Reduce adventure time 25%"
                                          IsChecked="{Binding ReduceAdventureTime}"
                                          ToolTip="When on, the adventure function also watches the bonus video to reduce the next adventure's duration by 25% (after the increase-danger step). Official Travian only. Skipped automatically if it is already active." />
                                <StackPanel Orientation="Horizontal" Margin="22,10,0,0">
                                    <TextBlock Text="Chance"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <TextBox Width="42"
                                             Padding="5,2"
                                             TextAlignment="Right"
                                             Text="{Binding AdventureVideoChancePercent, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="%"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                    ToolTip="Chance to run each enabled Hero Adventure bonus video. Applies independently to Hard and Reduce adventure time 25%. Default: 70%." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Attribute priority + Hero inventory side by side -->
            <Grid x:Name="AttributeInventoryGrid" Margin="2,0,2,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="AttributeColumn" Width="*" />
                    <ColumnDefinition x:Name="InventoryColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Attribute priority card -->
                <Border x:Name="AttributePriorityCard" Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,6,0">
                    <StackPanel>
                        <Border x:Name="AttributeAutomationCard"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Attribute automation"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Automatically spend free attribute points using the priority below."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSubtleBrush}"
                                           Margin="0,2,0,8" />
                                <CheckBox Content="Auto assign attribute points"
                                          IsChecked="{Binding AutoAssignPoints}" />
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Text="Attribute priority"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Border Width="14"
                                        Height="14"
                                        Margin="6,0,0,0"
                                        CornerRadius="7"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        ToolTipService.InitialShowDelay="0">
                                    <Border.ToolTip>
                                        <ToolTip MaxWidth="340">
                                            <StackPanel Width="300">
                                                <TextBlock Text="Attribute priority"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TooltipForegroundBrush}"
                                                           Margin="0,0,0,6" />
                                                <TextBlock TextWrapping="Wrap"
                                                           Text="When auto assign attribute points is enabled, points are assigned in this order. Use the arrow buttons to change priority." />
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <TextBlock Text="i"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <Button x:Name="RefreshHeroStatsButton"
                                    DockPanel.Dock="Right"
                                    Content="Refresh hero stats"
                                    Width="150"
                                    Command="{Binding RefreshStatsCommand}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" />
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource AppBackgroundBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource RowAltBackgroundBrush}"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0">
                            <StackPanel>
                                <Grid Margin="6,0,6,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="2"
                                               Text="Pts"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="10" />
                                    <TextBlock Grid.Column="3"
                                               Text="Max"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="10"
                                               ToolTip="Maximum total points for this attribute. Use 0 to skip it." />
                                </Grid>
                                <ListBox x:Name="HeroAttributePriorityItemsControl"
                                         HorizontalAlignment="Stretch"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ItemsSource="{Binding AttributePriorityItems}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,2" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="6,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="54" />
                                                        <ColumnDefinition Width="70" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Content="↑"
                                                                Width="22"
                                                                Height="20"
                                                                Padding="0"
                                                                Margin="0,0,3,0"
                                                                ToolTip="Move up"
                                                                Command="{Binding DataContext.MoveAttributeUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="↓"
                                                                Width="22"
                                                                Height="20"
                                                                Padding="0"
                                                                Margin="0"
                                                                ToolTip="Move down"
                                                                Command="{Binding DataContext.MoveAttributeDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Border Grid.Column="2"
                                                            Background="{DynamicResource AppBackgroundBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2">
                                                        <TextBlock Text="{Binding PointsText, StringFormat=Pts: {0}}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="11" />
                                                    </Border>
                                                    <TextBox Grid.Column="3"
                                                             Width="56"
                                                             Height="22"
                                                             HorizontalAlignment="Right"
                                                             VerticalContentAlignment="Center"
                                                             TextAlignment="Center"
                                                             Text="{Binding MaxPoints, Mode=OneWay}"
                                                             LostFocus="HeroAttributeMaximum_LostFocus"
                                                             KeyDown="HeroAttributeMaximum_KeyDown"
                                                             ToolTip="Maximum total points (0-100). Empty or invalid values use 100." />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding AttributesStatusText}"
                                           Foreground="{DynamicResource TextSubtleBrush}"
                                           FontSize="12"
                                           Margin="2,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Hero inventory card (placed where Adventures used to be). -->
                <Border x:Name="HeroInventoryCard" Grid.Column="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="6,0,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Hero inventory"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button x:Name="RefreshHeroInventoryButton"
                                        Style="{StaticResource RefreshIconButtonStyle}"
                                        Margin="8,0,0,0"
                                        ToolTip="Refresh hero inventory"
                                        Command="{Binding RefreshInventoryCommand}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Reuse the resource colors and card treatment from the Storage UI. -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,8,0" Padding="8" CornerRadius="8"
                                    Background="{DynamicResource WoodCardBgBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Wood" Foreground="{DynamicResource WoodTextBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding HeroInventoryWood}" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="0,0,8,0" Padding="8" CornerRadius="8"
                                    Background="{DynamicResource ClayCardBgBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Clay" Foreground="{DynamicResource ClayTextBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding HeroInventoryClay}" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Margin="0,0,8,0" Padding="8" CornerRadius="8"
                                    Background="{DynamicResource IronCardBgBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Iron" Foreground="{DynamicResource IronTextBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding HeroInventoryIron}" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Padding="8" CornerRadius="8"
                                    Background="{DynamicResource CropCardBgBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Crop" Foreground="{DynamicResource CropTextBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding HeroInventoryCrop}" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding HeroInventoryStatusText}"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />

                        <Border Margin="0,8,0,0"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <Grid Margin="14,12,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Hero resources by village"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <ContentControl Style="{DynamicResource InfoTooltipIconStyle}"
                                                            Margin="7,1,0,0"
                                                            ToolTip="Choose which villages and features may use resources from the hero inventory." />
                                        </StackPanel>
                                        <TextBlock Text="Control where inventory resources may be spent."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel x:Name="HeroResourceHeaderActionsPanel"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Max per resource"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <ContentControl Style="{DynamicResource InfoTooltipIconStyle}"
                                                        Margin="6,1,0,0"
                                                        ToolTip="Maximum hero inventory resources used per resource for one action." />
                                        <TextBox x:Name="HeroResourceMaxLimitTextBox"
                                                 Width="96"
                                                 Margin="10,0,16,0"
                                                 Padding="6,4"
                                                 Text="5000"
                                                 BorderBrush="{DynamicResource BorderSubtleBrush}" />
                                        <Button x:Name="ToggleAllHeroResourcesButton"
                                                Content="Toggle all villages"
                                                Padding="10,3"
                                                VerticalAlignment="Center"
                                                Click="ToggleAllHeroResources_Click"
                                                ToolTip="Turn hero resources on or off for every village." />
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <Grid MinWidth="720">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="0,1,0,1"
                                                Padding="14,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="54" />
                                                    <ColumnDefinition Width="*" MinWidth="140" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="118" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="ON" Style="{StaticResource HeroResourceHeaderTextStyle}" />
                                                <TextBlock Grid.Column="1" Text="VILLAGE" Style="{StaticResource HeroResourceHeaderTextStyle}" />
                                                <Button Grid.Column="2" Content="CONSTRUCTION" Style="{StaticResource HeroResourceColumnToggleStyle}"
                                                        Click="ToggleAllHeroConstruction_Click" ToolTip="Toggle Construction for every village." />
                                                <Button Grid.Column="3" Content="SMITHY" Style="{StaticResource HeroResourceColumnToggleStyle}"
                                                        Click="ToggleAllHeroSmithy_Click" ToolTip="Toggle Smithy for every village." />
                                                <Button Grid.Column="4" Content="BREWERY" Style="{StaticResource HeroResourceColumnToggleStyle}"
                                                        Click="ToggleAllHeroBrewery_Click" ToolTip="Toggle Brewery for every village." />
                                                <Button Grid.Column="5" Content="TOWN HALL" Style="{StaticResource HeroResourceColumnToggleStyle}"
                                                        Click="ToggleAllHeroTownHall_Click" ToolTip="Toggle Town Hall for every village." />
                                            </Grid>
                                        </Border>

                                        <ItemsControl Grid.Row="1"
                                                      ItemsSource="{Binding HeroResourceRows, ElementName=HeroPanelRoot}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="14,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="54" />
                                                                <ColumnDefinition Width="*" MinWidth="140" />
                                                                <ColumnDefinition Width="130" />
                                                                <ColumnDefinition Width="104" />
                                                                <ColumnDefinition Width="104" />
                                                                <ColumnDefinition Width="118" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Style="{DynamicResource ToggleSwitchBlueStyle}"
                                                                      IsChecked="{Binding IsHeroResourcesEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      ToolTip="Enable hero inventory resources for this village." />
                                                            <TextBlock Grid.Column="1" Text="{Binding VillageName}"
                                                                       VerticalAlignment="Center" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                            <CheckBox Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      IsChecked="{Binding UseConstruction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      ToolTip="Allow hero resources for construction." />
                                                            <CheckBox Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      IsChecked="{Binding UseSmithy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      ToolTip="Allow hero resources for Smithy upgrades." />
                                                            <CheckBox Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      IsChecked="{Binding UseBrewery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      ToolTip="Allow hero resources for Brewery celebrations." />
                                                            <CheckBox Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      IsChecked="{Binding UseTownHall, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      ToolTip="Allow hero resources for Town Hall celebrations." />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>

                                <Grid Margin="14,10,14,12">
                                    <TextBlock x:Name="HeroResourceSettingsStatusText"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SuccessTextBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
