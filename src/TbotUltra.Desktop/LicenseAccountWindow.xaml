<Window x:Class="TbotUltra.Desktop.LicenseAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tbot account" Width="520" Height="700" MinWidth="470" MinHeight="610"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="AccountCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="PackageCardStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" MinHeight="70" Padding="12"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource BorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource SuccessBgBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource SuccessBorderBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer x:Name="AccountContent" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22">
                <DockPanel Margin="0,0,0,16" LastChildFill="True">
                    <Button x:Name="OpenWebsiteButton" DockPanel.Dock="Right"
                            Content="Open account website" Padding="12,5"
                            Margin="12,0,0,0" VerticalAlignment="Center" Click="OpenWebsite_Click" />
                    <StackPanel>
                        <TextBlock Text="Tbot account" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Your license and registered program copies."
                                   Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>

                <Border x:Name="SessionStatusBorder" Style="{StaticResource AccountCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="SessionStatusDot" Width="10" Height="10"
                                 Fill="{DynamicResource InfoBrush}" Margin="0,4,10,0"
                                 VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="AccountStatusTitle" Text="Checking sign-in..."
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="AccountStatusDetail" Text="Looking for a saved account session."
                                       Margin="0,3,8,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="SignOutButton" Grid.Column="2" Content="Sign out"
                                Padding="12,4" VerticalAlignment="Center" Visibility="Collapsed"
                                Click="SignOut_Click" />
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="LICENSE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                <TextBlock x:Name="LicenseText" Margin="0,4,12,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="Sign in to view your license." />
                            </StackPanel>
                            <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Padding="12,4"
                                    VerticalAlignment="Center" Click="Refresh_Click" />
                        </Grid>
                        <Grid x:Name="SignedOutActionsPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                              Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SignInButton" Grid.Column="0" Content="Sign in"
                                    Margin="0,0,5,0" Background="{DynamicResource SuccessBgBrush}"
                                    Foreground="{DynamicResource SuccessTextBrush}"
                                    BorderBrush="{DynamicResource SuccessBorderBrush}" Click="SignIn_Click" />
                            <Button x:Name="CreateButton" Grid.Column="1" Content="Create account"
                                    Margin="5,0,0,0" Click="Create_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="BuyPanel" Style="{StaticResource AccountCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Buy prepaid time" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Choose a prepaid package, then continue to secure payment."
                                   Margin="0,4,0,10" Foreground="{DynamicResource TextSubtleBrush}" />
                        <UniformGrid x:Name="PackageOptionsPanel" Columns="2">
                            <RadioButton x:Name="Package1Button" GroupName="LicensePackage" Tag="1"
                                         Style="{StaticResource PackageCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="1 month" FontWeight="SemiBold" />
                                    <TextBlock Text="€2.99" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Package2Button" GroupName="LicensePackage" Tag="2"
                                         Style="{StaticResource PackageCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="2 months" FontWeight="SemiBold" />
                                    <TextBlock Text="€4.99" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Package6Button" GroupName="LicensePackage" Tag="6"
                                         IsChecked="True" Style="{StaticResource PackageCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="6 months" FontWeight="SemiBold" />
                                    <TextBlock Text="€13.99" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Package12Button" GroupName="LicensePackage" Tag="12"
                                         Style="{StaticResource PackageCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="12 months" FontWeight="SemiBold" />
                                    <TextBlock Text="€24.99" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                        <Button x:Name="OpenCheckoutButton" Content="Open Stripe Checkout" Padding="12,5"
                                HorizontalAlignment="Stretch" Margin="0,2,0,0" Click="Buy_Click" />
                        <Border Height="1" Margin="0,14,0,12"
                                Background="{DynamicResource BorderSubtleBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Have an existing-user code?"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button x:Name="RedeemCodeButton" Grid.Column="1" Content="Redeem code" Padding="12,4"
                                    Click="Redeem_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="ProgramCopiesPanel" Style="{StaticResource AccountCardStyle}" Margin="0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Program copies" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Each installation folder is one copy."
                                           Margin="0,3,10,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                            </StackPanel>
                            <Button x:Name="RemoveCopyButton" Grid.Column="1"
                                    Content="Remove selected copy" Padding="12,4"
                                    VerticalAlignment="Center" Click="RemoveCopy_Click" />
                        </Grid>
                        <ListBox x:Name="CopiesList" Height="56"
                                 Margin="0,8,0,0" Padding="3"
                                 HorizontalContentAlignment="Stretch"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Copy.Label}" />
                                        <TextBlock Grid.Column="1" Text="Active" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource SuccessTextBrush}"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LoadingOverlay" Panel.ZIndex="20"
              Background="{DynamicResource OverlayScrimBrush}">
            <Border Width="330" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource FocusBorderBrush}" BorderThickness="1"
                    CornerRadius="9">
                <StackPanel>
                    <TextBlock x:Name="LoadingText" Text="Loading Tbot account..."
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ProgressBar Height="6" Margin="0,14,0,0" IsIndeterminate="True"
                                 Foreground="{DynamicResource InfoBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
