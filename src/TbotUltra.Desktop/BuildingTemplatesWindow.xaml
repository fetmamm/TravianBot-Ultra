<Window x:Class="TbotUltra.Desktop.BuildingTemplatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TbotUltra.Desktop.Views"
        Title="Building templates"
        Width="1060"
        Height="680"
        MinWidth="920"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <PathGeometry x:Key="TemplatePlusIconGeometry"
                      Figures="M 12,5 L 12,19 M 5,12 L 19,12" />
        <PathGeometry x:Key="TemplateDuplicateIconGeometry"
                      Figures="M 4,4 L 15,4 L 15,15 L 4,15 Z M 9,9 L 20,9 L 20,20 L 9,20 Z" />
        <PathGeometry x:Key="TemplateDeleteIconGeometry"
                      Figures="M 5,7 L 19,7 M 9,4 L 15,4 M 7,7 L 8,20 L 16,20 L 17,7 M 11,10 L 11,17 M 14,10 L 14,17" />
        <PathGeometry x:Key="TemplateImportIconGeometry"
                      Figures="M 12,3 L 12,15 M 7,10 L 12,15 L 17,10 M 5,17 L 5,20 L 19,20 L 19,17" />
        <PathGeometry x:Key="TemplateExportIconGeometry"
                      Figures="M 12,16 L 12,4 M 7,9 L 12,4 L 17,9 M 5,17 L 5,20 L 19,20 L 19,17" />
        <Style x:Key="TemplateActionIconStyle" TargetType="Path">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="TemplateRowDeleteIconStyle" TargetType="Path">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="ExportMenuItemStyle" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemSurface"
                                Background="{TemplateBinding Background}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemSurface"
                                        Property="Background"
                                        Value="{DynamicResource InfoBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MenuItemSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Templates"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Templates}"
                         SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                         DisplayMemberPath="Name"
                         Background="{DynamicResource SurfaceAltBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" />
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <Button Width="32"
                            Height="28"
                            Padding="7"
                            Margin="0,0,6,0"
                            ToolTip="Create a new empty template"
                            AutomationProperties.Name="New template"
                            Background="{DynamicResource SuccessBgBrush}"
                            Foreground="{DynamicResource SuccessTextBrush}"
                            BorderBrush="{DynamicResource SuccessBorderBrush}"
                            Click="NewTemplateButton_Click">
                        <Path Data="{StaticResource TemplatePlusIconGeometry}"
                              Style="{StaticResource TemplateActionIconStyle}" />
                    </Button>
                    <Button Width="32"
                            Height="28"
                            Padding="7"
                            Margin="0,0,6,0"
                            ToolTip="Duplicate the selected template"
                            AutomationProperties.Name="Duplicate template"
                            Click="DuplicateTemplateButton_Click">
                        <Path Data="{StaticResource TemplateDuplicateIconGeometry}"
                              Style="{StaticResource TemplateActionIconStyle}" />
                    </Button>
                    <Button Width="32"
                            Height="28"
                            Padding="7"
                            Margin="0,0,6,0"
                            ToolTip="Delete the selected template"
                            AutomationProperties.Name="Delete template"
                            Background="{DynamicResource DangerBgBrush}"
                            Foreground="{DynamicResource DangerTextBrush}"
                            BorderBrush="{DynamicResource DangerBorderBrush}"
                            Click="DeleteTemplateButton_Click">
                        <Path Data="{StaticResource TemplateDeleteIconGeometry}"
                              Style="{StaticResource TemplateActionIconStyle}" />
                    </Button>
                    <Button Width="32"
                            Height="28"
                            Padding="7"
                            Margin="8,0,6,0"
                            ToolTip="Import shared templates"
                            AutomationProperties.Name="Import templates"
                            Click="ImportTemplatesButton_Click">
                        <Path Data="{StaticResource TemplateImportIconGeometry}"
                              Style="{StaticResource TemplateActionIconStyle}" />
                    </Button>
                    <Button x:Name="ExportTemplatesButton"
                            Width="32"
                            Height="28"
                            Padding="7"
                            ToolTip="Export templates"
                            AutomationProperties.Name="Export templates"
                            Click="ExportTemplatesButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Selected template"
                                          Style="{StaticResource ExportMenuItemStyle}"
                                          Click="ExportSelectedTemplateMenuItem_Click" />
                                <MenuItem Header="All templates"
                                          Style="{StaticResource ExportMenuItemStyle}"
                                          Click="ExportAllTemplatesMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Path Data="{StaticResource TemplateExportIconGeometry}"
                              Style="{StaticResource TemplateActionIconStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Name"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   FontSize="11" />
                        <TextBox Text="{Binding SelectedTemplate.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 Margin="0,3,0,0"
                                 Background="{DynamicResource SurfaceAltBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Text="Created by tribe"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   FontSize="11" />
                        <TextBlock Text="{Binding SelectedTemplate.CreatedByTribe}"
                                   FontWeight="SemiBold"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Add building"
                            Width="106"
                            Height="28"
                            Margin="0,0,6,0"
                            Click="AddBuildingRowButton_Click" />
                    <Button Content="Add resources"
                            Width="96"
                            Height="28"
                            Margin="0,0,6,0"
                            Click="AddAllResourcesRowButton_Click" />
                    <Button Content="Up"
                            Width="54"
                            Height="28"
                            Margin="0,0,6,0"
                            Click="MoveRowUpButton_Click" />
                    <Button Content="Down"
                            Width="62"
                            Height="28"
                            Click="MoveRowDownButton_Click" />
                    <Button Content="Top"
                            Width="54"
                            Height="28"
                            Margin="12,0,6,0"
                            Click="MoveRowTopButton_Click" />
                    <Button Content="Bottom"
                            Width="66"
                            Height="28"
                            Margin="0"
                            Click="MoveRowBottomButton_Click" />
                </StackPanel>

                <DataGrid Grid.Row="2"
                          x:Name="RowsGrid"
                          ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="{DynamicResource SurfaceAltBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          RowBackground="{DynamicResource SurfaceAltBrush}"
                          AlternatingRowBackground="{DynamicResource SurfaceBrush}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="#" Width="52">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Index}" Margin="6,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Task" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.RowKinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Building" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding TargetOptionsView}"
                                              SelectedItem="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              DropDownOpened="BuildingOptions_DropDownOpened"
                                              ScrollViewer.CanContentScroll="False"
                                              VirtualizingPanel.IsVirtualizing="False"
                                              MaxDropDownHeight="360">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem"
                                                   BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                <Setter Property="IsEnabled" Value="{Binding CanInvoke}" />
                                                <Setter Property="ToolTip" Value="{Binding AvailabilityReason}" />
                                                <EventSetter Event="PreviewMouseLeftButtonDown"
                                                             Handler="BuildingOption_PreviewMouseLeftButtonDown" />
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Availability}"
                                                                             Value="MissingRequirements">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Availability}"
                                                                             Value="Unavailable">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                                   Padding="6,6,6,2" />
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ComboBox.GroupStyle>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Slot" Width="82">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding SlotOptions}"
                                              SelectedItem="{Binding SlotText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsSlotSelectable}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Level" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.LevelOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding TargetLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Action" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="30"
                                            Height="24"
                                            Padding="0"
                                            Margin="4,0"
                                            ToolTip="Delete row"
                                            Background="{DynamicResource DangerBgBrush}"
                                            Foreground="{DynamicResource DangerTextBrush}"
                                            BorderBrush="{DynamicResource DangerBorderBrush}"
                                            Click="DeleteRowButton_Click">
                                        <Viewbox Width="14" Height="14" Stretch="Uniform">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource TemplateDeleteIconGeometry}"
                                                      Style="{StaticResource TemplateRowDeleteIconStyle}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="3"
                        Margin="0,8,0,0"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="From new village:"
                                   FontWeight="SemiBold"
                                   Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="Cost" Margin="0,0,5,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding TotalWoodText}"
                                   Foreground="{DynamicResource WoodTextBrush}" />
                        <TextBlock Grid.Column="3" Text=" | " Foreground="{DynamicResource TextSubtleBrush}" />
                        <TextBlock Grid.Column="4"
                                   Text="{Binding TotalClayText}"
                                   Foreground="{DynamicResource ClayTextBrush}" />
                        <TextBlock Grid.Column="5" Text=" | " Foreground="{DynamicResource TextSubtleBrush}" />
                        <TextBlock Grid.Column="6"
                                   Text="{Binding TotalIronText}"
                                   Foreground="{DynamicResource IronTextBrush}" />
                        <TextBlock Grid.Column="7" Text=" | " Foreground="{DynamicResource TextSubtleBrush}" />
                        <TextBlock Grid.Column="8"
                                   Text="{Binding TotalCropText}"
                                   Foreground="{DynamicResource CropTextBrush}" />
                        <TextBlock Grid.Column="10"
                                   Text="{Binding TotalTimeText}"
                                   Margin="12,0,0,0" />
                        <TextBlock Grid.Column="11"
                                   Text="{Binding TotalConstructFasterTimeText}"
                                   Foreground="{DynamicResource ConstructFasterBrush}"
                                   Margin="12,0,0,0" />
                        <TextBlock Grid.Column="12"
                                   Text="{Binding ValidationSummaryText}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Show building slots"
                            Width="142"
                            Height="30"
                            HorizontalAlignment="Left"
                            Click="ShowBuildingSlotsButton_Click" />
                    <Button Grid.Column="1"
                            Content="Save"
                            Width="86"
                            Height="30"
                            Margin="0,0,8,0"
                            Background="{DynamicResource SuccessBgBrush}"
                            Foreground="{DynamicResource SuccessTextBrush}"
                            BorderBrush="{DynamicResource SuccessBorderBrush}"
                            Click="SaveButton_Click" />
                    <Button Grid.Column="2"
                            Content="Close"
                            Width="82"
                            Height="30"
                            Margin="0,0,8,0"
                            Click="CloseButton_Click" />
                    <Button Grid.Column="3"
                            Content="Queue template"
                            Width="118"
                            Height="30"
                            Background="{DynamicResource InfoBgBrush}"
                            Foreground="{DynamicResource InfoTextBrush}"
                            BorderBrush="{DynamicResource InfoBrush}"
                            Click="QueueTemplateButton_Click" />
                    <Button Grid.Column="4"
                            Content="Queue to multiple villages"
                            Width="190"
                            Height="30"
                            Margin="8,0,0,0"
                            Background="{DynamicResource InfoBgBrush}"
                            Foreground="{DynamicResource InfoTextBrush}"
                            BorderBrush="{DynamicResource InfoBrush}"
                            Click="QueueMultipleVillagesButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <views:BusyOverlayControl x:Name="LoadingOverlay"
                                  Grid.ColumnSpan="3"
                                  Panel.ZIndex="100"
                                  Margin="-14"
                                  Title="Building templates"
                                  Text="Loading templates..."
                                  IsBusy="True"
                                  ShowCancel="True"
                                  Cancelled="LoadingOverlay_Cancelled" />
    </Grid>
</Window>
