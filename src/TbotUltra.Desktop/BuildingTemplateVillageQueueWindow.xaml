<Window x:Class="TbotUltra.Desktop.BuildingTemplateVillageQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Queue template to multiple villages"
        Width="600"
        Height="560"
        MinWidth="500"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Queue to multiple villages"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="All villages that can safely use this template are selected by default."
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSubtleBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Villages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,10"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   Margin="22,3,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSubtleBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ActionCountText}"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Queue"
                    Width="100"
                    Height="30"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Background="{DynamicResource InfoBgBrush}"
                    Foreground="{DynamicResource InfoTextBrush}"
                    BorderBrush="{DynamicResource InfoBrush}"
                    Click="QueueButton_Click" />
            <Button Content="Cancel"
                    Width="82"
                    Height="30"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
