<Window x:Class="TbotUltra.Desktop.OfficialAddFarmsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TbotUltra.Desktop.Views"
        Title="Add Farms to Lists"
        Width="820"
        Height="780"
        MinWidth="740"
        MinHeight="660"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="WorkflowCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="WorkflowStepTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="WorkflowStepDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="2,0,2,12">
                <TextBlock Text="Add farms to lists"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Choose where farms come from, where they go, and how they are added."
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSubtleBrush}" />
                <Border x:Name="IncompleteReadWarningBorder" Visibility="Collapsed"
                        Margin="0,8,0,0" CornerRadius="6" Padding="10,8"
                        Background="#3A2A00" BorderBrush="#C9962B" BorderThickness="1">
                    <TextBlock x:Name="IncompleteReadWarningTextBlock" TextWrapping="Wrap"
                               Foreground="#F2C14E" />
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="2,0,4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource WorkflowCardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Source" Style="{StaticResource WorkflowStepTitleStyle}" />
                                    <TextBlock Text="Select the saved targets and the village used to calculate distance."
                                               Style="{StaticResource WorkflowStepDescriptionStyle}" />
                                </StackPanel>
                            </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SOURCE LIST" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                <ComboBox x:Name="SourceListComboBox" Margin="0,5,0,0"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="SourceListComboBox_SelectionChanged" />
                                <Border Margin="0,10,0,0"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,7">
                                    <DockPanel>
                                        <TextBlock x:Name="SourceCountTextBlock"
                                                   DockPanel.Dock="Right"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessTextStrongBrush}" />
                                        <TextBlock Text="AVAILABLE FARMS" FontSize="10" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSubtleBrush}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DISTANCE FROM VILLAGE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                <ComboBox x:Name="FromVillageComboBox" Margin="0,5,0,0"
                                          DisplayMemberPath="DisplayName" SelectionChanged="InputChanged" />
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Margin="0,10,0,0" Style="{StaticResource WorkflowCardStyle}">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Target protection"
                                               Style="{StaticResource WorkflowStepTitleStyle}"
                                               VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource SettingInfoIconStyle}">
                                        <ContentControl.ToolTip>
                                            <ToolTip MaxWidth="340">
                                                <TextBlock TextWrapping="Wrap"
                                                           Text="Player and alliance are checked live in Travian after coordinates resolve and before Save. Use semicolons or new lines between names." />
                                            </ToolTip>
                                        </ContentControl.ToolTip>
                                    </ContentControl>
                                </StackPanel>
                                <TextBlock Text="Skip account allies and named targets before they are saved."
                                           Style="{StaticResource WorkflowStepDescriptionStyle}" />
                            </StackPanel>

                            <CheckBox x:Name="ExcludeOwnAllianceCheckBox"
                                      Content="Exclude own alliance (loading...)"
                                      IsChecked="True"
                                      IsEnabled="False"
                                      Checked="InputChanged"
                                      Unchecked="InputChanged" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="EXCLUDED ALLIANCES" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSubtleBrush}" />
                                    <TextBox x:Name="ExcludedAlliancesTextBox"
                                             Margin="0,5,0,0"
                                             Height="28"
                                             AcceptsReturn="False"
                                             TextWrapping="NoWrap"
                                             ToolTip="Separate names with semicolons." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="EXCLUDED PLAYERS" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSubtleBrush}" />
                                    <TextBox x:Name="ExcludedPlayersTextBox"
                                             Margin="0,5,0,0"
                                             Height="28"
                                             AcceptsReturn="False"
                                             TextWrapping="NoWrap"
                                             ToolTip="Separate names with semicolons." />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource WorkflowCardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="CheckAllTargetsButton"
                                        DockPanel.Dock="Right"
                                        Content="Check all"
                                        MinWidth="90"
                                        Padding="12,4"
                                        Click="CheckAllTargets_Click" />
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Destination farm lists" Style="{StaticResource WorkflowStepTitleStyle}" />
                                    <TextBlock Text="Choose one or more lists to receive farms."
                                               Style="{StaticResource WorkflowStepDescriptionStyle}" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="TargetListsListBox" MaxHeight="190">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Checked="TargetCheckBox_Changed"
                                                      Unchecked="TargetCheckBox_Changed"
                                                      Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource WorkflowCardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Settings" Style="{StaticResource WorkflowStepTitleStyle}" />
                                    <TextBlock Text="Control capacity, ordering, distance, and duplicate handling."
                                               Style="{StaticResource WorkflowStepDescriptionStyle}" />
                                </StackPanel>
                            </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Amount per list" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="FillModeRadioButton" Content="Fill" IsChecked="True"
                                             Margin="0,0,14,0" Checked="InputChanged" />
                                <RadioButton x:Name="AmountModeRadioButton" Content="Amount"
                                             Margin="0,0,10,0" Checked="InputChanged" />
                                <ComboBox x:Name="AmountComboBox" Width="90" SelectionChanged="InputChanged" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Order" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <ComboBox x:Name="OrderComboBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                                      SelectionChanged="InputChanged">
                                <ComboBoxItem Tag="distance_asc" Content="Distance - shortest first" IsSelected="True" />
                                <ComboBoxItem Tag="distance_desc" Content="Distance - longest first" />
                                <ComboBoxItem Tag="pop_desc" Content="Population - highest first" />
                                <ComboBoxItem Tag="pop_asc" Content="Population - lowest first" />
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="Population filter" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PopulationFilterComboBox" SelectionChanged="InputChanged">
                                    <ComboBoxItem Tag="all" Content="All populations" IsSelected="True" />
                                    <ComboBoxItem Tag="under" Content="Under or equal to" />
                                    <ComboBoxItem Tag="over" Content="Over or equal to" />
                                </ComboBox>
                                <TextBox x:Name="PopulationTextBox" Grid.Column="2" Text="50" TextChanged="InputChanged" />
                            </Grid>

                            <TextBlock Grid.Row="3" Text="Distance filter" VerticalAlignment="Center" Margin="0,10,0,0" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox x:Name="DistanceFilterCheckBox" Content="Within"
                                          Checked="InputChanged" Unchecked="InputChanged" />
                                <TextBox x:Name="DistanceTextBox" Width="100" Margin="12,0,8,0"
                                         Text="20" TextChanged="InputChanged" />
                                <TextBlock Text="fields" VerticalAlignment="Center" />
                            </StackPanel>

                            <CheckBox x:Name="SkipDuplicatesCheckBox" Grid.Row="4" Grid.ColumnSpan="2"
                                      Margin="0,14,0,0"
                                      Content="Don't add duplicates already present in any farm list"
                                      IsChecked="True" Checked="InputChanged" Unchecked="InputChanged" />
                            <CheckBox x:Name="SkipLowPopVillagesCheckBox" Grid.Row="5" Grid.ColumnSpan="2"
                                      Margin="0,8,0,0"
                                      Content="Don't add villages with 8 population or less"
                                      IsChecked="False" Checked="InputChanged" Unchecked="InputChanged" />
                        </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource WorkflowCardStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Troops" Style="{StaticResource WorkflowStepTitleStyle}" />
                                    <TextBlock Text="Use each list's saved troops or apply one custom troop setup."
                                               Style="{StaticResource WorkflowStepDescriptionStyle}" />
                                </StackPanel>
                            </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SEND WITH" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                <ComboBox x:Name="TroopModeComboBox" Margin="0,5,0,0"
                                          SelectionChanged="TroopModeComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="default" Content="Default" IsSelected="True" />
                                    <ComboBoxItem Tag="custom" Content="Custom" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TROOP TYPE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                <ComboBox x:Name="TroopTypeComboBox" Margin="0,5,0,0"
                                          SelectionChanged="InputChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="TROOP COUNT" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSubtleBrush}" />
                                <TextBox x:Name="TroopCountTextBox" Margin="0,5,0,0"
                                         TextChanged="InputChanged" />
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="OasisFilterBorder" Grid.Row="5" Margin="0,10,0,0"
                            Visibility="Collapsed" Style="{StaticResource WorkflowCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Oasis filter"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <ContentControl Style="{StaticResource SettingInfoIconStyle}">
                                    <ContentControl.ToolTip>
                                        <ToolTip MaxWidth="320">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Pick which oasis types from the selected list to add, and whether to include occupied oases. Only applies to map-oasis lists." />
                                        </ToolTip>
                                    </ContentControl.ToolTip>
                                </ContentControl>
                            </StackPanel>
                            <ItemsControl x:Name="OasisSingleTypesItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Type}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Margin="0,0,18,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl x:Name="OasisComboTypesItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Type}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Margin="0,0,18,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox x:Name="IncludeOccupiedCheckBox" Margin="0,6,0,0"
                                      Content="Include occupied oases"
                                      Checked="InputChanged" Unchecked="InputChanged" />
                        </StackPanel>
                    </Border>

                    </Grid>
                </Border>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="AddButton" Content="Add farms" Width="110" Margin="0,0,8,0"
                        Background="{DynamicResource SuccessBgBrush}"
                        Foreground="{DynamicResource SuccessTextBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                        Click="AddButton_Click" />
                <Button Content="Cancel" Width="100" Click="CancelButton_Click" />
            </StackPanel>
        </Grid>

        <views:BusyOverlayControl x:Name="LoadingOverlay"
                                  Title="Adding farms"
                                  Text="Preparing..."
                                  Cancelled="LoadingOverlay_Cancelled" />

        <!-- Modern, compact progress card shown while farms are being added. Shows the list being added to,
             the added/requested progress, and an Invalid + Elapsed footer. -->
        <Border x:Name="AddingOverlay" Visibility="Collapsed"
                Background="{DynamicResource OverlayScrimBrush}">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28,24"
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Adding farms"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="AddingCurrentListText"
                               Text="-"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,18" />

                    <ProgressBar x:Name="AddingProgressBar"
                                 Minimum="0" Maximum="100" Value="0"
                                 Height="8"
                                 Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,16">
                        <TextBlock x:Name="AddingAddedText"
                                   Text="0 / 0 added"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Left" />
                        <TextBlock x:Name="AddingPercentText"
                                   Text="0%"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <Border BorderBrush="{DynamicResource BorderMutedBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0"
                            Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                <TextBlock Text="Invalid" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" />
                                <TextBlock x:Name="AddingInvalidText" Text="0"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Elapsed" FontSize="11"
                                           Foreground="{DynamicResource TextSubtleBrush}"
                                           HorizontalAlignment="Right" />
                                <TextBlock x:Name="AddingElapsedText" Text="00:00:00"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button x:Name="AddingCancelButton"
                            Content="Cancel"
                            MinWidth="110"
                            Height="32"
                            Padding="14,0"
                            Background="{DynamicResource DangerBgBrush}"
                            BorderBrush="{DynamicResource DangerBorderBrush}"
                            Foreground="{DynamicResource DangerTextBrush}"
                            HorizontalAlignment="Center"
                            Click="AddingCancelButton_Click" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
