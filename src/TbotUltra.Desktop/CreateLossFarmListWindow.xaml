<Window x:Class="TbotUltra.Desktop.CreateLossFarmListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loss farm destination"
        Width="500"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Choose a destination for red/yellow farms"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,12"
                   Text="Use an existing holding list or create a new one."
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="2">
            <Border Padding="10"
                    Margin="0,0,0,8"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <RadioButton x:Name="UseExistingRadioButton"
                                 GroupName="LossFarmDestinationMode"
                                 Content="Use an existing farmlist"
                                 FontWeight="SemiBold"
                                 Checked="DestinationMode_Changed" />
                    <ComboBox x:Name="ExistingListsComboBox"
                              Margin="24,8,0,0"
                              DisplayMemberPath="DisplayText"
                              SelectionChanged="ExistingListsComboBox_SelectionChanged" />
                </StackPanel>
            </Border>
            <Border Padding="10"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <RadioButton x:Name="CreateNewRadioButton"
                                 GroupName="LossFarmDestinationMode"
                                 Content="Create a new farmlist"
                                 FontWeight="SemiBold"
                                 Checked="DestinationMode_Changed" />
                    <TextBox x:Name="ListNameTextBox"
                             Margin="24,8,0,0"
                             MaxLength="30"
                             TextChanged="ListNameTextBox_TextChanged" />
                </StackPanel>
            </Border>
        </StackPanel>
        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="3"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource WarningTextBrush}"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConfirmButton"
                    Content="Continue"
                    MinWidth="140"
                    Margin="0,0,8,0"
                    Background="{DynamicResource SuccessBgBrush}"
                    BorderBrush="{DynamicResource SuccessBorderBrush}"
                    Foreground="{DynamicResource SuccessTextBrush}"
                    Click="ConfirmButton_Click" />
            <Button Content="Cancel" Width="90" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
