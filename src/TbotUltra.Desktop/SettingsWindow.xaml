                                    <ColumnDefinition Width="53" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Daily spending limit" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                    ToolTip="Maximum silver allowed to be spent each day. Resets at 00:00 server time." />
                                </StackPanel>
                                <TextBox x:Name="DailySilverSpendingLimitTextBox"
                                         Grid.Column="1"
                                         Text="{Binding SettingsVm.DailySilverSpendingLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Height="30"
                                        MinWidth="70"
                                        Padding="9,3"
                                        Margin="0,0,6,0"
                                        Background="{DynamicResource SuccessBgBrush}"
                                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <TextBlock x:Name="DailySilverSpendingUsageTextBlock"
                                               Text="{Binding SettingsVm.DailySilverSpendingUsageText}"
                                               Foreground="{DynamicResource SuccessTextBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="ResetDailySilverLimitButton"
                                        Content="Reset daily limits"
                                        Command="{Binding SettingsVm.ResetDailySilverSpendingCommand}" />
                            </StackPanel>

                            <Border Height="1"
                                    Background="{DynamicResource BorderSubtleBrush}"
                                    Margin="0,18,0,16" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Gold spending"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <CheckBox x:Name="AllowGoldSpendingCheckBox"
                                      Content="Allow gold spending"
                                      IsChecked="{Binding SettingsVm.AllowGoldSpending, Mode=TwoWay}"
                                      Margin="0,0,0,12"
                                      ToolTip="Allows gold-spending features such as NPC trade. Spending respects the daily gold limit below." />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="53" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Minimum gold balance" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                    ToolTip="Minimum gold balance to keep. Gold spending must not reduce the balance below this value." />
                                </StackPanel>
                                <TextBox x:Name="GoldLimitTextBox"
                                         Grid.Column="1"
                                         Text="{Binding SettingsVm.GoldLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="53" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Daily spending limit" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                    ToolTip="Maximum gold allowed to be spent each day. Resets at 00:00 server time." />
                                </StackPanel>
                                <TextBox x:Name="DailyGoldSpendingLimitTextBox"
                                         Grid.Column="1"
                                         Text="{Binding SettingsVm.DailyGoldSpendingLimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Height="30"
                                        MinWidth="70"
                                        Padding="9,3"
                                        Margin="0,0,6,0"
                                        Background="{DynamicResource SuccessBgBrush}"
                                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <TextBlock x:Name="DailyGoldSpendingUsageTextBlock"
                                               Text="{Binding SettingsVm.DailyGoldSpendingUsageText}"
                                               Foreground="{DynamicResource SuccessTextBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Button x:Name="ResetDailyGoldLimitButton"
                                        Content="Reset daily limits"
                                        Command="{Binding SettingsVm.ResetDailyGoldSpendingCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="ImportSettingsButton"
                        MinWidth="116"
                        Height="32"
                        Padding="14,0"
                        Content="Import settings"
                        FontWeight="SemiBold"
                        Click="ImportSettingsButton_Click" />
                <Button x:Name="ExportSettingsButton"
                        MinWidth="116"
                        Height="32"
                        Padding="14,0"
                        Margin="8,0,20,0"
                        Content="Export settings"
                        FontWeight="SemiBold"
                        Click="ExportSettingsButton_Click" />
                <Button x:Name="ResetSettingsButton"
                        MinWidth="106"
                        Height="32"
                        Padding="14,0"
                        Content="Reset settings"
                        FontWeight="SemiBold"
                        Background="{DynamicResource WarningBgBrush}"
                        Foreground="{DynamicResource WarningTextBrush}"
                        BorderBrush="{DynamicResource WarningBorderBrush}"
                        Command="{Binding SettingsVm.ResetSettingsCommand}" />
                <Button x:Name="SleepNowButton"
                        MinWidth="88"
                        Height="32"
                        Padding="14,0"
                        Margin="8,0,0,0"
                        Content="Sleep now"
                        FontWeight="SemiBold"
                        Background="{DynamicResource InfoBgBrush}"
                        Foreground="{DynamicResource InfoTextBrush}"
                        BorderBrush="{DynamicResource InfoBrush}"
                        ToolTip="Stop automation, log out, and sleep now for the configured sleep time."
                        Command="{Binding SettingsVm.SleepNowCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton"
                        MinWidth="88"
                        Height="32"
                        Padding="16,0"
                        Margin="0,0,8,0"
                        Content="Save"
                        FontWeight="SemiBold"
                        Background="{DynamicResource SuccessBgBrush}"
                        Foreground="{DynamicResource SuccessTextBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                        Command="{Binding SettingsVm.SaveCommand}" />
                <Button x:Name="CancelButtonControl" Width="100" Content="Cancel" Command="{Binding SettingsVm.CancelCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
