<Window x:Class="TbotUltra.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TbotUltra.Desktop"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="Settings"
        Height="720"
        Width="780"
        MinHeight="520"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Closing="SettingsWindow_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Badges.xaml" />
                <!-- Buttons.xaml is also merged app-wide in App.xaml, but this window is constructed
                     standalone in tests, where StaticResource lookups cannot reach App resources. -->
                <ResourceDictionary Source="Themes/Buttons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Lightweight section divider: settings are grouped by spacing and hierarchy, not nested cards. -->
            <Style x:Key="SettingsGroupBox" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0,0,0,16" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="SettingsCategoryCardStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Visibility" Value="Collapsed" />
            </Style>
            <Style x:Key="GeneralSettingsCategoryStyle" TargetType="Border" BasedOn="{StaticResource SettingsCategoryCardStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabControl}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PacingSettingsCategoryStyle" TargetType="Border" BasedOn="{StaticResource SettingsCategoryCardStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabControl}" Value="1">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ConstructionSettingsCategoryStyle" TargetType="Border" BasedOn="{StaticResource SettingsCategoryCardStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabControl}" Value="2">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="HeroSettingsCategoryStyle" TargetType="Border" BasedOn="{StaticResource SettingsCategoryCardStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabControl}" Value="3">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="FarmingSettingsCategoryStyle" TargetType="Border" BasedOn="{StaticResource SettingsCategoryCardStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabControl}" Value="4">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TroopsSettingsCategoryStyle" TargetType="Border" BasedOn="{StaticResource SettingsCategoryCardStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabControl}" Value="5">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NpcTradeSettingsCategoryStyle" TargetType="Border" BasedOn="{StaticResource SettingsCategoryCardStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabControl}" Value="7">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CelebrationsSettingsCategoryStyle" TargetType="Border" BasedOn="{StaticResource SettingsCategoryCardStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=SettingsCategoryTabControl}" Value="6">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SettingsCategoryTabStyle" TargetType="TabItem">
                <!-- Match the compact, square tab treatment used by Village settings. -->
                <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0,0,0,2"
                                    Margin="0,0,2,0"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="False" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="TabSurface" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,4,12" VerticalAlignment="Center">
                    <TextBlock Text="Bot Settings"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}"
                               VerticalAlignment="Center" />
                    <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                    Margin="7,1,0,0"
                                    ToolTip="Configure execution, automation, and spending behavior." />
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="8,8,0,0">
                    <TabControl x:Name="SettingsCategoryTabControl"
                                Height="44"
                                SelectedIndex="0"
                                Background="Transparent"
                                BorderThickness="0"
                                SelectionChanged="SettingsCategoryTabControl_SelectionChanged"
                                ItemContainerStyle="{StaticResource SettingsCategoryTabStyle}">
                        <TabItem Header="General" />
                        <TabItem Header="Pacing" />
                        <TabItem Header="Construction" />
                        <TabItem Header="Hero" />
                        <TabItem Header="Farming" />
                        <TabItem Header="Troops" />
                        <TabItem Header="Celebrations" />
                        <TabItem Header="NPC / Trade" />
                    </TabControl>
                </Border>

                <Border Grid.Row="2"
                        Padding="20,18"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,8,8">
                    <ScrollViewer x:Name="SettingsContentScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">

                    <Border Style="{StaticResource GeneralSettingsCategoryStyle}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,22"
                            Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="General"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="DontNotifyNewVersionCheckBox"
                                          Content="Dont notify for new version"
                                          IsChecked="{Binding SettingsVm.DontNotifyNewVersion, Mode=TwoWay}" />
                                <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                ToolTip="Suppresses the popup shown when a newer version is available. Updates can still be checked and installed manually from the version window." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="QuickReloginCheckBox"
                                          Content="Quick re-login within 2 hours"
                                          IsChecked="{Binding SettingsVm.QuickReloginEnabled, Mode=TwoWay}" />
                                <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                ToolTip="When logging in less than 2hrs after the last full login, skip the post-login analyzes and only confirm the session. &#10;Recommended to keep ON" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="AutomaticallyCheckLanguageCheckBox"
                                          Content="Automatically check language"
                                          IsChecked="{Binding SettingsVm.AutomaticallyCheckLanguage, Mode=TwoWay}" />
                                <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                ToolTip="Checks that Travian is set to English before automation parses pages. Turn off only if the language guard itself causes problems." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox x:Name="DetailedBrowserLoggingCheckBox"
                                          Content="Detailed browser logging (development only)"
                                          IsChecked="{Binding SettingsVm.DetailedBrowserLoggingEnabled, Mode=TwoWay}"
                                          Checked="DetailedBrowserLoggingCheckBox_Changed"
                                          Unchecked="DetailedBrowserLoggingCheckBox_Changed" />
                                <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                ToolTip="Development only. Records detailed browser actions, navigation, reloads, refreshes, reads, waits, retries, and cache decisions. This can create large log files and slightly affect performance. Keep this OFF during normal use." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                <CheckBox x:Name="DailyServerResetOverrideCheckBox"
                                          Content="Daily server reset (manual)"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding SettingsVm.DailyServerResetOverrideEnabled, Mode=TwoWay}" />
                                <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                ToolTip="The server-local whole hour when the game day resets. The bot auto-detects this from the daily quests dialog per account — the detected value is shown on the right. Leave the toggle OFF to use the detected value; turn it ON only to override it manually (e.g. if detection is wrong)." />
                                <ComboBox x:Name="DailyServerResetHourComboBox"
                                          Width="80"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding SettingsVm.DailyServerResetOverrideEnabled}"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding SettingsVm.DailyServerResetHour, Mode=TwoWay}" />
                                <Border Background="{DynamicResource SuccessBgBrush}"
                                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="9,2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="DailyServerResetDetectedTextBlock"
                                               Foreground="{DynamicResource SuccessTextBrush}" />
                                </Border>
                            </StackPanel>
                            <Border Style="{StaticResource SettingsGroupBox}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Video flow"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="TurnOffVideoSoundCheckBox"
                                                  Content="Turn off video sound"
                                                  IsChecked="{Binding SettingsVm.TurnOffVideoSound, Mode=TwoWay}" />
                                        <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                        ToolTip="Best-effort: clicks only a verified visible audio icon. If the control cannot be identified safely, the video continues with sound." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PacingSettingsCategoryStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Bot behavior"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button x:Name="ResetPacingButton"
                                        Style="{StaticResource RefreshIconButtonStyle}"
                                        Margin="8,0,0,0"
                                        ToolTip="Reset pacing defaults"
                                        Command="{Binding SettingsVm.ResetPacingCommand}" />
                            </StackPanel>

                            <Border Style="{StaticResource SettingsGroupBox}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox x:Name="SessionPacingEnabledCheckBox" Content="Session pacing" FontWeight="SemiBold" IsChecked="{Binding SettingsVm.Pacing.SessionPacingEnabled, Mode=TwoWay}" />
                                                    <ContentControl Style="{StaticResource SettingInfoIconStyle}" ToolTip="Uses random run and sleep periods. Choose this for a regular online/offline rhythm that does not depend on task timers." />
                                                </StackPanel>
                                                <TextBlock Text="Random online and offline periods." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="20,3,0,10" />
                                                <Grid Margin="20,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="80" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Column="1" Text="Min" FontWeight="SemiBold" Margin="0,2" />
                                                    <TextBlock Grid.Column="2" Text="Max" FontWeight="SemiBold" Margin="6,2,0,2" />
                                                    <TextBlock Grid.Row="1" Text="Run (min)" VerticalAlignment="Center" Margin="0,2" />
                                                    <TextBox x:Name="SessionRunMinMinutesTextBox" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,2" Text="{Binding SettingsVm.Pacing.SessionRunMinMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox x:Name="SessionRunMaxMinutesTextBox" Grid.Row="1" Grid.Column="2" Height="24" Margin="6,2,0,2" Text="{Binding SettingsVm.Pacing.SessionRunMaxMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Row="2" Text="Sleep (min)" VerticalAlignment="Center" Margin="0,2" />
                                                    <TextBox x:Name="SessionSleepMinMinutesTextBox" Grid.Row="2" Grid.Column="1" Height="24" Margin="0,2" Text="{Binding SettingsVm.Pacing.SessionSleepMinMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox x:Name="SessionSleepMaxMinutesTextBox" Grid.Row="2" Grid.Column="2" Height="24" Margin="6,2,0,2" Text="{Binding SettingsVm.Pacing.SessionSleepMaxMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox x:Name="SmartSleepEnabledCheckBox" Content="Smart sleep" FontWeight="SemiBold" IsChecked="{Binding SettingsVm.Pacing.SmartSleepEnabled, Mode=TwoWay}" />
                                                    <ContentControl Style="{StaticResource SettingInfoIconStyle}" ToolTip="Sleeps only when the scheduler knows that no task is needed soon, then wakes near the next task." />
                                                </StackPanel>
                                                <TextBlock Text="Sleep between known task deadlines." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="20,3,0,10" />
                                                <Grid Margin="20,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="68" />
                                                        <ColumnDefinition Width="68" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Column="1" Text="Min" FontWeight="SemiBold" Margin="0,2" />
                                                    <TextBlock Grid.Column="2" Text="Max" FontWeight="SemiBold" Margin="6,2,0,2" />
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Sleep opportunity" VerticalAlignment="Center" />
                                                        <ContentControl Style="{StaticResource SettingInfoIconStyle}" ToolTip="Minimum free time required before Smart Sleep closes the browser. Shorter gaps stay online. Default: 20 minutes." />
                                                    </StackPanel>
                                                    <TextBox x:Name="SmartSleepMinimumOpportunityTextBox" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,2" Text="{Binding SettingsVm.Pacing.SmartSleepMinimumOpportunityMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="minutes" VerticalAlignment="Center" Margin="6,2,0,2" />
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Wake window" VerticalAlignment="Center" />
                                                        <ContentControl Style="{StaticResource SettingInfoIconStyle}" ToolTip="Randomizes login around the next task. Min is minutes before the deadline; Max is minutes after it." />
                                                    </StackPanel>
                                                    <TextBox x:Name="SmartSleepWakeBeforeTextBox" Grid.Row="2" Grid.Column="1" Height="24" Margin="0,2" Text="{Binding SettingsVm.Pacing.SmartSleepWakeBeforeMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox x:Name="SmartSleepWakeAfterTextBox" Grid.Row="2" Grid.Column="2" Height="24" Margin="6,2,0,2" Text="{Binding SettingsVm.Pacing.SmartSleepWakeAfterMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Fallback check" VerticalAlignment="Center" />
                                                        <ContentControl Style="{StaticResource SettingInfoIconStyle}" ToolTip="When no future task time is known, log in after a random Min–Max delay and run one village status check. Default: 30–60 minutes." />
                                                    </StackPanel>
                                                    <TextBox x:Name="SmartSleepFallbackMinTextBox" Grid.Row="3" Grid.Column="1" Height="24" Margin="0,2" Text="{Binding SettingsVm.Pacing.SmartSleepFallbackMinMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox x:Name="SmartSleepFallbackMaxTextBox" Grid.Row="3" Grid.Column="2" Height="24" Margin="6,2,0,2" Text="{Binding SettingsVm.Pacing.SmartSleepFallbackMaxMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                        <TextBlock Text="Shared limits" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <ContentControl Style="{StaticResource SettingInfoIconStyle}" ToolTip="These limits apply to whichever sleep mode is enabled. They do nothing when both Session pacing and Smart sleep are off." />
                                    </StackPanel>
                                    <Grid Margin="18,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Daily max" VerticalAlignment="Center" Margin="0,2" />
                                        <ComboBox x:Name="SessionDailyMaxHoursComboBox" Grid.Column="1" Height="24" Margin="0,2" SelectedValuePath="Tag" SelectedValue="{Binding SettingsVm.Pacing.SessionDailyMaxHours, Mode=TwoWay}" SelectionChanged="SessionDailyMaxHoursComboBox_SelectionChanged" />
                                        <ComboBox x:Name="SessionDailyMaxVariationComboBox" Grid.Column="2" Height="24" Margin="6,2,0,2" SelectedValuePath="Tag" SelectedValue="{Binding SettingsVm.Pacing.SessionDailyMaxVariationPercent, Mode=TwoWay}" ToolTip="Daily max variation: randomizes the daily limit by this much each day." />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="18,0,0,6">
                                        <TextBlock Text="Allowed hours" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                        ToolTip="Checked hours may run. Unchecked hours log out and stay stopped until the next checked hour." />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding SettingsVm.Pacing.SessionAllowedHours}"
                                                  Margin="18,0,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <local:VerticalFirstUniformGrid Columns="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Margin="0,2,8,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="18,12,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Daily variation" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                        ToolTip="Shifts each allowed-hours on/off boundary by ± this percent of an hour (e.g. 30% = ±18 min), so the bot does not start or stop at the exact same clock time every day. Set to 0 to keep exact hours." />
                                        <ComboBox x:Name="SessionHoursVariationComboBox" Width="110" Height="24" Margin="8,0,0,0" SelectedValuePath="Tag" SelectedValue="{Binding SettingsVm.Pacing.SessionHoursVariationPercent, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsGroupBox}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Action pacing"
                                                   VerticalAlignment="Center" />
                                        <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                        ToolTip="Adds small randomized pauses around central bot actions such as tasks, page loads, farm sends, and loop passes." />
                                    </StackPanel>
                                    <Grid Margin="18,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Min s" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Max s" FontWeight="SemiBold" />
                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                            <TextBlock Text="Task" VerticalAlignment="Center" />
                                            <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                            VerticalAlignment="Center"
                                                            ToolTip="Randomized pause before each state-changing bot task (build, upgrade, send, etc.), so actions are not fired back-to-back at machine speed." />
                                        </StackPanel>
                                        <TextBox x:Name="ActionTaskMinTextBox" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,2,6,2" Text="{Binding SettingsVm.Pacing.TaskMinSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox x:Name="ActionTaskMaxTextBox" Grid.Row="1" Grid.Column="2" Height="24" Margin="0,2,0,2" Text="{Binding SettingsVm.Pacing.TaskMaxSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                            <TextBlock Text="Page load" VerticalAlignment="Center" />
                                            <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                            VerticalAlignment="Center"
                                                            ToolTip="Randomized pause after a page finishes loading or reloading, before the bot reads it or acts on it." />
                                        </StackPanel>
                                        <TextBox x:Name="ActionPageLoadMinTextBox" Grid.Row="2" Grid.Column="1" Height="24" Margin="0,2,6,2" Text="{Binding SettingsVm.Pacing.PageLoadMinSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox x:Name="ActionPageLoadMaxTextBox" Grid.Row="2" Grid.Column="2" Height="24" Margin="0,2,0,2" Text="{Binding SettingsVm.Pacing.PageLoadMaxSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                            <TextBlock Text="Click" VerticalAlignment="Center" />
                                            <ContentControl Style="{StaticResource SettingInfoIconStyle}"
                                                            VerticalAlignment="Center"
