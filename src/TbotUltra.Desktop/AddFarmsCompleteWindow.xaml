<Window x:Class="TbotUltra.Desktop.AddFarmsCompleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="Add farms complete"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Add farms complete"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="SubtitleText"
                       Margin="0,4,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Stat tiles -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource SuccessBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Added" FontSize="11"
                               Foreground="{DynamicResource TextSubtleBrush}" />
                    <TextBlock x:Name="AddedValueText" Text="0"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessTextBrush}" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Duplicates" FontSize="11"
                               Foreground="{DynamicResource TextSubtleBrush}" />
                    <TextBlock x:Name="DuplicatesValueText" Text="0"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Occupied" FontSize="11"
                               Foreground="{DynamicResource TextSubtleBrush}" />
                    <TextBlock x:Name="OccupiedValueText" Text="0"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border x:Name="FailedTile"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Failed" FontSize="11"
                               Foreground="{DynamicResource TextSubtleBrush}" />
                    <TextBlock x:Name="FailedValueText" Text="0"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,12">
            <Border Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Players skipped" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" />
                    <TextBlock x:Name="ExcludedPlayersValueText" Text="0" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Alliances skipped" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" />
                    <TextBlock x:Name="ExcludedAlliancesValueText" Text="0" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,7">
                <StackPanel>
                    <TextBlock Text="Identity errors" FontSize="11" Foreground="{DynamicResource TextSubtleBrush}" />
                    <TextBlock x:Name="IdentityUnavailableValueText" Text="0" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Elapsed -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8">
            <Grid>
                <TextBlock Text="Elapsed" FontSize="12"
                           Foreground="{DynamicResource TextSubtleBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left" />
                <TextBlock x:Name="ElapsedValueText" Text="00:00:00"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- Invalid coordinates info (only when invalid > 0) -->
        <Border x:Name="InvalidPanel"
                Grid.Row="4"
                Visibility="Collapsed"
                Background="{DynamicResource InfoBgBrush}"
                BorderBrush="{DynamicResource FocusBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,12,0,0">
            <TextBlock x:Name="InvalidText"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource InfoTextBrush}" />
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="5" Margin="0,18,0,0">
            <Button x:Name="CloseButton"
                    Content="Close"
                    Width="100"
                    Height="32"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Click="CloseButton_Click" />
            <StackPanel x:Name="RemoveButtons"
                        Orientation="Horizontal"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right">
                <Button x:Name="KeepButton"
                        Content="Keep"
                        Width="100"
                        Height="32"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="KeepButton_Click" />
                <Button x:Name="RemoveButton"
                        Content="Remove them"
                        MinWidth="120"
                        Height="32"
                        Padding="14,0"
                        Background="{DynamicResource SuccessBgBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                        Foreground="{DynamicResource SuccessTextBrush}"
                        FontWeight="SemiBold"
                        Click="RemoveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
